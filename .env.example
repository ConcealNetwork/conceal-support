# ---- Core -------------------------------------------------------------------
APP_URL=https://support.conceal.network
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs sessions and magic links.
APP_SECRET=
DATABASE_URL=postgres://conceal:conceal@postgres:5432/conceal_support

# ---- Attachments: self-hosted MinIO ------------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=support-attachments

# ---- Outbound email (support@conceal.network) -------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Conceal Support <support@conceal.network>"
# Reply-To is built as <MAIL_REPLY_LOCALPART>+<trackingId>@<MAIL_REPLY_DOMAIN>
MAIL_REPLY_DOMAIN=conceal.network
MAIL_REPLY_LOCALPART=support

# ---- Inbound email (IMAP poller, run by `npm run worker`) -------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60

# ---- Discord -----------------------------------------------------------------
# Bot: https://discord.com/developers/applications → Bot → token. Needs
# "Server Members Intent" for role checks. OAuth2 redirect:
#   <APP_URL>/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_QUEUE_CHANNEL_ID=
DISCORD_SECURITY_CHANNEL_ID=
DISCORD_STAFF_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=

# ---- Signal (optional; bbernhard/signal-cli-rest-api) ------------------------
SIGNAL_API_URL=http://signal:8080
SIGNAL_NUMBER=
SIGNAL_GROUP_ID=

# ---- Anti-abuse: Cloudflare Turnstile (optional; forms work without it) -----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Data sources ------------------------------------------------------------
EXPLORER_URL=https://explorer.conceal.network
EXPLORER_API_URL=https://explorer.conceal.network/daemon
BRIDGE_URL=https://bridge.conceal.network
DOCS_URL=https://concealnetwork.github.io/conceal-wiki
GITHUB_ORG=ConcealNetwork

# ---- Bootstrap ---------------------------------------------------------------
# Email of the first admin; `npm run db:seed` creates the staff row. They then
# link Discord on first login.
BOOTSTRAP_ADMIN_EMAIL=
