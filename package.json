{
  "name": "conceal-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "types:check": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/seed.ts",
    "discord:register": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/discord-register-commands.ts",
    "worker": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/worker.ts",
    "verify": "npm run lint && npm run types:check && npm run test && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.1.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "imapflow": "^1.7.8",
    "lucide-react": "^1.41.0",
    "mailparser": "^3.14.1",
    "marked": "^18.0.11",
    "minio": "^8.0.7",
    "next": "^16.3.4",
    "nodemailer": "^10.3.1",
    "otplib": "^13.5.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
